# All settings are optional; values shown are the defaults.

# Timeouts (seconds). TOTAL is a hard deadline for DNS + all redirect hops + body.
LINKPEEK_CONNECT_TIMEOUT=3
LINKPEEK_READ_TIMEOUT=5
LINKPEEK_TOTAL_TIMEOUT=8

# Limits
LINKPEEK_MAX_BODY_BYTES=1000000
LINKPEEK_MAX_REDIRECTS=3
LINKPEEK_MAX_URL_LENGTH=2048
LINKPEEK_ALLOWED_PORTS=[80,443,8080,8443]
LINKPEEK_USER_AGENT="linkpeek/1.0 (+https://github.com/samiktare/linkpeek)"

# Cache (seconds / entries)
LINKPEEK_CACHE_TTL=3600
LINKPEEK_NEGATIVE_CACHE_TTL=60
LINKPEEK_CACHE_MAX_SIZE=1000

# Rate limiting, per client IP
LINKPEEK_RATE_LIMIT_REQUESTS=30
LINKPEEK_RATE_LIMIT_WINDOW=60
# Set true only behind a proxy that appends the client IP (Render, Fly.io).
LINKPEEK_TRUST_X_FORWARDED_FOR=false
